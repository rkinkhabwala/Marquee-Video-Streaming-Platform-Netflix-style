POSTGRES_DB=marquee
POSTGRES_USER=marquee
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_USER=marquee
RABBITMQ_PASSWORD=replace-with-a-local-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_ROOT_USER=marquee
MINIO_ROOT_PASSWORD=replace-with-a-local-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

API_PORT=8080
WEB_PORT=3000
TRANSCODER_PORT=8081

# Signing secrets (any long random strings locally).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
STREAM_TOKEN_SECRET=replace-with-another-long-random-secret

# Seed data created on API start-up (admin, viewer with adult + kids profiles, genres).
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@marquee.local
SEED_ADMIN_PASSWORD=replace-with-a-local-password
SEED_USER_EMAIL=viewer@marquee.local
SEED_USER_PASSWORD=replace-with-a-local-password

# Recommendation system (Phase 3), started with scripts/recsys.sh. Must match recsys/recsys.env.
RECSYS_ENABLED=true
RECSYS_API_KEY=marquee-local-recsys-key
